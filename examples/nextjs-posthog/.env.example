# Copiez ce fichier en .env.local et renseignez vos propres valeurs.
# .env.local ne doit jamais être commité (voir .gitignore à la racine du dépôt).
#
# Laissée vide, NEXT_PUBLIC_POSTHOG_KEY désactive l'intégration PostHog :
# lib/posthog-client.ts renvoie alors null et aucun événement n'est envoyé.
# C'est le comportement par défaut attendu tant que PostHog n'est pas
# explicitement configuré pour ce projet.

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://posthog.votre-domaine.example

# Nom du cookie/état utilisé pour vérifier le consentement publicitaire avant tout
# tracking de conversion vers un fournisseur externe (Google Ads, Meta Ads, LinkedIn Ads...).
# Voir skills/ads-conversion-tracking/SKILL.md. Laissée vide par défaut : aucun tracking
# publicitaire n'est activé tant que ce mécanisme n'est pas implémenté et documenté.
NEXT_PUBLIC_ADS_CONSENT_COOKIE_NAME=
